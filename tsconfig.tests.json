{
  "compilerOptions": {
    "target": "ES2022",
    /* DOM as well as node: the pixel helper's analysis runs inside the page. */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["tests", "playwright.config.ts"]
}
